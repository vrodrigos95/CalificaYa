# Configuración de CalificaYa. Copia este archivo a .env y ajusta los valores
# (en Netlify: Site configuration → Environment variables).
# Todo lo configurable de la app se lee únicamente en src/config.ts.

# --- Licencia ---
# Endpoint central de licencias de trucosdeaula.com. Acepta la clave de CalificaYa o la del Pase Maestro.
# Solo responde a https://trucosdeaula.com y sus subdominios (la app debe vivir en calificaya.trucosdeaula.com).
VITE_LICENCIA_URL=https://trucosdeaula.com/api/licencia.php
VITE_COMPRA_URL=PLACEHOLDER_URL_CALIFICAYA
VITE_PASE_URL=PLACEHOLDER_URL_PASE
# false (por ahora): CalificaYa es gratis y la licencia se activa, opcional, en Ajustes.
# true: sin licencia activa la app muestra la pantalla de activación.
VITE_LICENCIA_OBLIGATORIA=false
VITE_SUPPORT_EMAIL=soporte@ejemplo.com
VITE_MAX_DISPOSITIVOS=3
VITE_HORAS_REVALIDACION=24
VITE_DIAS_SIN_CONEXION=7
